                        [
                            a rdfhtml:Style ;
                            rdfhtml:children (
                                [
                                    a rdfhtml:Text ;
                                    rdfhtml:data "\n    :root {\n      color-scheme: light;\n      --canvas: oklch(94.5% 0.012 65);\n      --paper: oklch(99% 0.006 75);\n      --ink: oklch(20% 0.018 65);\n      --muted: oklch(45% 0.025 55);\n      --rule: oklch(79% 0.025 65);\n      --review: oklch(42% 0.15 28);\n      --review-soft: oklch(96% 0.025 28);\n      --review-rule: oklch(78% 0.07 28);\n      --violet: oklch(39% 0.12 294);\n      --focus: oklch(58% 0.17 294);\n      --signal: oklch(80% 0.14 135);\n      --ui: \"Avenir Next\", Avenir, \"Segoe UI Variable\", \"Segoe UI\", sans-serif;\n      --legal: Georgia, \"Times New Roman\", Times, serif;\n    }\n\n    * { box-sizing: border-box; }\n    html { background: var(--canvas); scroll-behavior: smooth; }\n    body { color: var(--ink); margin: 0; }\n    a { color: inherit; }\n    :where(a, button, summary):focus-visible {\n      outline: 3px solid var(--focus);\n      outline-offset: 3px;\n    }\n    [hidden] { display: none !important; }\n\n    .skip-link {\n      background: var(--ink);\n      color: var(--paper);\n      font: 700 .85rem/1 var(--ui);\n      left: 1rem;\n      padding: .8rem 1rem;\n      position: fixed;\n      top: 1rem;\n      transform: translateY(-180%);\n      z-index: 20;\n    }\n    .skip-link:focus { transform: translateY(0); }\n\n    .document-tools {\n      align-items: center;\n      background: oklch(23% 0.04 294);\n      color: oklch(97% 0.01 294);\n      display: flex;\n      font-family: var(--ui);\n      gap: 1.25rem;\n      justify-content: space-between;\n      min-height: 4rem;\n      padding: .7rem clamp(1rem, 4vw, 3rem);\n      position: sticky;\n      top: 0;\n      z-index: 10;\n    }\n    .tool-identity { align-items: baseline; display: flex; gap: .8rem; min-width: 0; }\n    .tool-identity strong { color: var(--signal); font-size: 1.05rem; letter-spacing: -.04em; }\n    .tool-identity span { font-size: .78rem; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n    .tool-actions { align-items: center; display: flex; gap: .5rem; }\n    .tool-link {\n      align-items: center;\n      border: 1px solid oklch(66% 0.04 294);\n      display: inline-flex;\n      font-size: .72rem;\n      font-weight: 700;\n      min-height: 2.5rem;\n      padding: .55rem .8rem;\n      text-decoration: none;\n    }\n    .tool-link:hover { background: oklch(31% 0.06 294); }\n\n    .document-shell { padding: clamp(1rem, 3vw, 3.5rem); }\n    .review-surface {\n      background: var(--paper);\n      border: 1px solid var(--rule);\n      box-shadow: 0 18px 50px oklch(28% 0.03 60 / 9%), 0 2px 8px oklch(28% 0.03 60 / 5%);\n      margin: 0 auto;\n      max-width: 92rem;\n      padding: clamp(1.4rem, 5vw, 4.5rem);\n    }\n    .review-header,\n    .relationship,\n    .questions,\n    .annotations,\n    .semantic-sources {\n      margin-left: auto;\n      margin-right: auto;\n      max-width: 62rem;\n    }\n    .review-header {\n      border-bottom: 1px solid var(--review-rule);\n      margin-bottom: 2rem;\n      padding-bottom: 2rem;\n    }\n    .classification {\n      color: var(--review);\n      font: 800 .7rem/1.2 var(--ui);\n      letter-spacing: .09em;\n      margin: 0 0 1rem;\n      text-transform: uppercase;\n    }\n    .review-header h1 {\n      font: 700 clamp(1.8rem, 5vw, 3.2rem)/1.02 var(--legal);\n      letter-spacing: -.025em;\n      margin: 0;\n      max-width: 18ch;\n    }\n    .review-header .lede {\n      color: var(--muted);\n      font: 1.03rem/1.62 var(--legal);\n      margin: 1.25rem 0 0;\n      max-width: 66ch;\n    }\n\n    .relationship {\n      align-items: start;\n      background: var(--review-soft);\n      border: 1px solid var(--review-rule);\n      display: grid;\n      font-family: var(--ui);\n      gap: 1rem;\n      grid-template-columns: minmax(0, 1fr) auto;\n      margin: 0 0 2.6rem;\n      padding: 1rem 1.1rem;\n    }\n    .relationship strong { color: var(--review); display: block; font-size: .75rem; letter-spacing: .055em; text-transform: uppercase; }\n    .relationship p { font-size: .85rem; line-height: 1.5; margin: .35rem 0 0; }\n    .relationship a {\n      border-bottom: 1px solid currentColor;\n      color: var(--violet);\n      font-size: .78rem;\n      font-weight: 750;\n      padding: .15rem 0;\n      text-decoration: none;\n    }\n\n    .section-title {\n      font: 800 .76rem/1.3 var(--ui);\n      letter-spacing: .08em;\n      margin: 0 0 1rem;\n      text-transform: uppercase;\n    }\n    .questions {\n      border-bottom: 1px solid var(--rule);\n      margin-bottom: 2.6rem;\n      padding-bottom: 2.2rem;\n    }\n    .questions ol { margin: 0; padding-left: 1.5rem; }\n    .questions li {\n      font: 1rem/1.55 var(--legal);\n      margin: .65rem 0;\n      padding-left: .35rem;\n    }\n    .questions a { color: var(--violet); text-decoration-thickness: 1px; text-underline-offset: .18em; }\n\n    .policy-workspace {\n      border-bottom: 1px solid var(--rule);\n      margin: 0 0 3rem;\n      padding: 0 0 3rem;\n    }\n    .workspace-header {\n      align-items: end;\n      display: grid;\n      gap: 1rem;\n      grid-template-columns: minmax(0, 1fr) minmax(15rem, 28rem);\n      margin-bottom: 1.2rem;\n    }\n    .workspace-header h2 {\n      font: 700 clamp(1.45rem, 3vw, 2.1rem)/1.1 var(--legal);\n      letter-spacing: -.018em;\n      margin: 0;\n    }\n    .workspace-header p {\n      color: var(--muted);\n      font: .82rem/1.5 var(--ui);\n      margin: 0;\n    }\n    .workspace-grid {\n      align-items: start;\n      display: grid;\n      gap: 1rem;\n      grid-template-columns: minmax(0, 1.1fr) minmax(22rem, .9fr);\n    }\n    .reviewed-document {\n      background: oklch(96% 0.012 65);\n      border: 1px solid var(--rule);\n      min-width: 0;\n    }\n    .pane-heading {\n      align-items: center;\n      border-bottom: 1px solid var(--rule);\n      display: flex;\n      flex-wrap: wrap;\n      font: 700 .7rem/1.2 var(--ui);\n      gap: .35rem .8rem;\n      justify-content: space-between;\n      letter-spacing: .05em;\n      min-height: 2.8rem;\n      padding: .65rem .85rem;\n      text-transform: uppercase;\n    }\n    .pane-heading a {\n      color: var(--violet);\n      font-size: .66rem;\n      letter-spacing: 0;\n      margin-left: auto;\n      text-transform: none;\n      white-space: nowrap;\n    }\n    .reviewed-document iframe {\n      background: white;\n      border: 0;\n      display: block;\n      height: min(46rem, 75vh);\n      width: 100%;\n    }\n\n    .annotation-list { border-top: 1px solid var(--ink); }\n    .annotation {\n      display: grid;\n      gap: clamp(1rem, 3vw, 2.4rem);\n      grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);\n      padding: 1.25rem 0 1.4rem;\n    }\n    .annotation + .annotation { border-top: 1px solid var(--rule); }\n    .annotation-target {\n      font-family: var(--ui);\n      min-width: 0;\n    }\n    .annotation-target span {\n      color: var(--review);\n      display: block;\n      font-size: .66rem;\n      font-weight: 800;\n      letter-spacing: .07em;\n      margin-bottom: .35rem;\n      text-transform: uppercase;\n    }\n    .annotation-target a {\n      color: var(--violet);\n      font-size: .83rem;\n      font-weight: 720;\n      line-height: 1.35;\n      text-decoration-thickness: 1px;\n      text-underline-offset: .2em;\n    }\n    .annotation p { font: 1rem/1.58 var(--legal); margin: 0; }\n\n    .semantic-sources {\n      border-top: 1px solid var(--rule);\n      font-family: var(--ui);\n      margin-top: 3rem;\n      padding-top: 1.2rem;\n    }\n    .semantic-sources h2 { font-size: .88rem; margin: 0 0 .55rem; }\n    .semantic-sources p { color: var(--muted); font-size: .72rem; line-height: 1.55; margin: 0; }\n    .semantic-sources a { color: var(--violet); }\n\n    @media (max-width: 720px) {\n      .document-tools { align-items: flex-start; flex-direction: column; gap: .55rem; position: static; }\n      .tool-actions { flex-wrap: wrap; }\n      .tool-link { min-height: 2.75rem; }\n      .document-shell { padding: 0; }\n      .review-surface { border: 0; padding: 1.7rem 1.1rem 3rem; }\n      .relationship,\n      .annotation { grid-template-columns: 1fr; }\n      .relationship a { justify-self: start; }\n      .annotation { gap: .6rem; }\n      .workspace-header,\n      .workspace-grid { grid-template-columns: 1fr; }\n      .reviewed-document iframe { height: 36rem; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n    }\n    @media print {\n      @page { margin: .72in .78in; size: letter; }\n      html,\n      body { background: var(--paper); }\n      .document-tools,\n      .skip-link,\n      .policy-workspace { display: none; }\n      .document-shell { padding: 0; }\n      .review-surface { border: 0; box-shadow: none; max-width: none; padding: 0; }\n      .annotation { break-inside: avoid; }\n      a { text-decoration: none; }\n      .semantic-sources { display: none; }\n    }\n  "
                                ]
                            )
                        ]
