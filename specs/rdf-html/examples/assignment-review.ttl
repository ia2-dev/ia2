                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n            "
                                                                ]
                                                                [
                                                                    a rdfhtml:P ;
                                                                    rdfhtml:id "review-note-10" ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-subject" ;
                                                                        rdfhtml:attributeValue "#review-note-10"
                                                                    ] ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-predicate" ;
                                                                        rdfhtml:attributeValue "http://www.w3.org/ns/oa#bodyValue"
                                                                    ] ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-graph" ;
                                                                        rdfhtml:attributeValue "#review-graph"
                                                                    ] ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data "Standard assignor package: contract alive, no default, no prior assignment or encumbrance (protects against a double transfer), and authority."
                                                                        ]
                                                                    )
                                                                ]
                                                                [
                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n          "
                                                                ]
