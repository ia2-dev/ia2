                                                                    rdfhtml:data "PROV-O"
                                                                ]
                                                            )
                                                        ]
                                                        [
                                                            a rdfhtml:Text ;
                                                            rdfhtml:data " records authorship and derivation. The "
                                                        ]
                                                        [
                                                            a rdfhtml:A ;
                                                            rdfhtml:href "https://ontology.inferal.com/modules/artifact-evolution/" ;
                                                            rdfhtml:children (
