                                                                        rdfhtml:attributeName "rdf-predicate" ;
                                                                        rdfhtml:attributeValue "http://www.w3.org/ns/oa#bodyValue"
                                                                    ] ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-graph" ;
                                                                        rdfhtml:attributeValue "#review-graph"
                                                                    ] ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data "The single source of truth for liability allocation; the "
                                                                        ]
                                                                        [
                                                                            a rdfhtml:A ;
                                                                            rdfhtml:href "assignment.html#clause-conditions" ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Conditions"
                                                                                ]
                                                                            )
                                                                        ]
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data " and "
                                                                        ]
                                                                        [
                                                                            a rdfhtml:A ;
                                                                            rdfhtml:href "assignment.html#clause-indemnification" ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Indemnification"
                                                                                ]
                                                                            )
                                                                        ]
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data " clauses inherit whatever is elected here. First option (our default): Assignee takes post-Effective-Date obligations only, pre-date obligations stay with Assignor by operation of law. Second option: Assignee takes everything, used when the old entity is dissolving. Question for counsel: confirm the default election."
                                                                        ]
                                                                    )
                                                                ]
