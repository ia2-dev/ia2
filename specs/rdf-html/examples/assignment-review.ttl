                                                            a rdfhtml:Article ;
                                                            rdfhtml:class "annotation" ;
                                                            rdfhtml:children (
                                                                [
                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n            "
                                                                ]
                                                                [
                                                                    a rdfhtml:Div ;
                                                                    rdfhtml:class "annotation-target" ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Span ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Operational control"
                                                                                ]
                                                                            )
                                                                        ]
                                                                        [
                                                                            a rdfhtml:A ;
                                                                            rdfhtml:href "assignment.html#clause-conditions" ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Conditions to Consent clause"
                                                                                ]
                                                                            )
                                                                        ]
                                                                    )
                                                                ]
                                                                [
                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n            "
                                                                ]
                                                                [
                                                                    a rdfhtml:P ;
                                                                    rdfhtml:id "review-note-9" ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-subject" ;
                                                                        rdfhtml:attributeValue "#review-note-9"
                                                                    ] ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-predicate" ;
                                                                        rdfhtml:attributeValue "http://www.w3.org/ns/oa#bodyValue"
                                                                    ] ;
                                                                    rdfhtml:attribute [
                                                                        a rdfhtml:Attribute ;
                                                                        rdfhtml:attributeName "rdf-graph" ;
                                                                        rdfhtml:attributeValue "#review-graph"
                                                                    ] ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data "The core protections are: paid-up condition so invoices are not orphaned; one-time consent that does not open the door to future assignments or waive the Contract's anti-assignment clause; and reservation of all pre-transfer claims, including latent ones. Verify the account is current before countersigning."
                                                                        ]
                                                                    )
                                                                ]
                                                                [
                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n          "
                                                                ]
