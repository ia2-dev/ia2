<https://ia2.dev/spec/rdf-html/examples/assignment-review#document>
    a rdfhtml:Document ;
    rdfhtml:base <https://ia2.dev/spec/rdf-html/examples/sources/assignment-review.html> ;
    dcterms:conformsTo <https://ia2.dev/spec/rdf-html/vocabulary/rdf-html-2026-07-18.ttl> ;
