                                                            rdfhtml:data "SELECT $this WHERE {\n  $this\n    <https://ia2.dev/spec/rdf-html/examples/sources/assignment.html#signatureMark>\n    ?counterpartySignature .\n  FILTER(\n    NOT EXISTS {\n      <https://ia2.dev/spec/rdf-html/examples/sources/assignment.html#assignor-signature>\n        <https://ia2.dev/spec/rdf-html/examples/sources/assignment.html#signatureMark>\n        ?assignorSignature .\n    }\n    ||\n    NOT EXISTS {\n      <https://ia2.dev/spec/rdf-html/examples/sources/assignment.html#assignee-signature>\n        <https://ia2.dev/spec/rdf-html/examples/sources/assignment.html#signatureMark>\n        ?assigneeSignature .\n    }\n  )\n}"
