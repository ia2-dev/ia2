                                                            a rdfhtml:Text ;
                                                            rdfhtml:data "\n          "
                                                        ]
                                                        [
                                                            a rdfhtml:Article ;
                                                            rdfhtml:class "annotation" ;
                                                            rdfhtml:children (
                                                                [
                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n            "
                                                                ]
                                                                [
                                                                    a rdfhtml:Div ;
                                                                    rdfhtml:class "annotation-target" ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Span ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Election requires confirmation"
                                                                                ]
                                                                            )
                                                                        ]
                                                                        [
