                                                                        rdfhtml:attributeValue "#review-graph"
                                                                    ] ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data "Consideration recital. New York GOL §§ 5-1107 and 5-1103 make signed written assignments and modifications enforceable without consideration, but the recital is kept for versatility in non-New York deals."
                                                                        ]
                                                                    )
                                                                ]
                                                                [
