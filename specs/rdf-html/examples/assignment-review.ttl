                                                                ]
                                                            )
                                                        ]
                                                        [
                                                            a rdfhtml:Text ;
                                                            rdfhtml:data " models each question and assessment independently of the target contract. "
                                                        ]
                                                        [
                                                            a rdfhtml:A ;
                                                            rdfhtml:href "https://www.w3.org/TR/shacl/" ;
                                                            rdfhtml:children (
