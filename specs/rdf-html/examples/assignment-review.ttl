                                                            rdfhtml:class "annotation" ;
                                                            rdfhtml:children (
                                                                [
                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "\n            "
                                                                ]
                                                                [
                                                                    a rdfhtml:Div ;
                                                                    rdfhtml:class "annotation-target" ;
                                                                    rdfhtml:children (
                                                                        [
                                                                            a rdfhtml:Span ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Drafting rationale"
                                                                                ]
                                                                            )
                                                                        ]
                                                                        [
                                                                            a rdfhtml:A ;
                                                                            rdfhtml:href "assignment.html#clause-assignee-reps" ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Assignee representations clause"
                                                                                ]
                                                                            )
