                                                                            rdfhtml:data "The underlying transaction is deliberately not described here. It appears once, as an operative representation in the "
                                                                        ]
                                                                        [
                                                                            a rdfhtml:A ;
                                                                            rdfhtml:href "assignment.html#clause-assignee-reps" ;
                                                                            rdfhtml:children (
                                                                                [
                                                                                    a rdfhtml:Text ;
                                                                                    rdfhtml:data "Assignee representations clause"
                                                                                ]
                                                                            )
                                                                        ]
                                                                        [
                                                                            a rdfhtml:Text ;
                                                                            rdfhtml:data ", avoiding two fill-ins that could be completed inconsistently."
