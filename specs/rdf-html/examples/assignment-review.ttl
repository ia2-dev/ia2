                                                                    a rdfhtml:Text ;
                                                                    rdfhtml:data "Artifact Evolution ontology"
                                                                ]
                                                            )
                                                        ]
                                                        [
                                                            a rdfhtml:Text ;
                                                            rdfhtml:data " identifies this review as a versioned artifact. The contract's FIBO semantics remain entirely in the related contract document."
                                                        ]
