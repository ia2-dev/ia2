    dcterms:license <https://github.com/ia2-dev/ia2/blob/main/LICENSE> ;
    dcterms:creator "IA² contributors" ;
    dcterms:description "Internal legal-review experiment carrying Web Annotations that target stable IRIs in a separately distributable contract document." ;
