                                                        a rdfhtml:Attribute ;
                                                        rdfhtml:attributeName "rdf-predicate" ;
                                                        rdfhtml:attributeValue "http://purl.org/dc/terms/hasPart"
                                                    ] ;
                                                    rdfhtml:attribute [
