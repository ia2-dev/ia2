{
  "name": "@ia2-dev/rdf-value-editor",
  "version": "0.1.1",
  "description": "A SHACL- and Web Annotation-driven RDF value editor for HTML/RDF datasets.",
  "author": "Yurii Rashkovskii",
  "homepage": "https://ia2.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ia2-dev/ia2.git",
    "directory": "packages/rdf-value-editor"
  },
  "bugs": {
    "url": "https://github.com/ia2-dev/ia2/issues"
  },
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rdf-value-editor.js",
      "default": "./dist/rdf-value-editor.js"
    }
  },
  "main": "./dist/rdf-value-editor.js",
  "module": "./dist/rdf-value-editor.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --splitting --format=esm --platform=browser --target=es2022 --outdir=dist --entry-names=rdf-value-editor --chunk-names=chunks/[name]-[hash] --sourcemap",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "rdf",
    "rdfjs",
    "shacl",
    "html",
    "linked-data",
    "ia2",
    "web-component",
    "forms"
  ],
  "license": "MIT",
  "dependencies": {
    "@ia2-dev/html-rdf": "^0.1.1",
    "@ia2-dev/ui-primitives": "^0.1.1",
    "@rdfjs/data-model": "^2.1.2",
    "@rdfjs/dataset": "^2.0.3",
    "n3": "^2.1.1",
    "shacl-engine": "^1.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/n3": "^1.26.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
